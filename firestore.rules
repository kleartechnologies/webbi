rules_version = '2';

// Webbi Firestore rules.
//
// Collections
//   users/{uid}         – minimal profile, owner only.
//   sites/{siteId}      – one document per website. Owner reads it and may edit
//                         the draft content. Websites are created and deleted
//                         only by the server (POST /api/sites, /api/sites/delete),
//                         which allows one unpublished website per account.
//                         Status, slug, payment and the published copy are
//                         written only by the server (Admin SDK) after verified
//                         payment.
//   userQuotas/{uid}    – server only: the account's unpublished website, the
//                         number of websites it started today, and its AI
//                         requests this day and month.
//   siteAi/{siteId}     – server only: AI requests made for one website and the
//                         lock that allows one AI request per website at a time.
//                         moderationStatus ("active" | "suspended") is written
//                         only by the server; a suspended site's draft can't be
//                         edited from a browser either.
//   siteModeration/{id} – server only: why a website was suspended.
//   aiBudget/{period}   – server only: Webbi-wide AI requests this day/month.
//   publicSites/{slug}  – the published copy of a site (or, while its website is
//                         suspended, a marker with no content). Anyone can get
//                         one by its link; nobody can list them. Server written.
//                         This is the only collection the public renderer
//                         (/w/[slug]) reads.
//   slugs/{slug}        – slug registry, server only.
//   payments/{id}       – payment records, server written, owner readable.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(doc) {
      return signedIn() && doc.data.ownerUid == request.auth.uid;
    }

    function isString(v, max) {
      return v is string && v.size() <= max;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'locale', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    match /sites/{siteId} {
      allow read: if isOwner(resource);

      // Starting and deleting a website go through the server, so the limit of
      // one unpublished website per account can't be skipped from a browser.
      allow create, delete: if false;

      // Editing is limited to the draft content and its bookkeeping fields.
      // ownerUid, status, paid, slug, published and the moderation fields can
      // never be changed here, and a suspended website can't be edited at all.
      allow update: if isOwner(resource)
        && resource.data.get('moderationStatus', 'active') != 'suspended'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['draft', 'sourceDescription', 'generation', 'language', 'updatedAt'])
        && isString(request.resource.data.sourceDescription, 4000);
    }

    match /userQuotas/{uid} {
      allow read, write: if false;
    }

    // AI counts and locks: only the AI routes (Admin SDK) touch these.
    match /siteAi/{siteId} {
      allow read, write: if false;
    }

    // Webbi-wide AI budget: only the AI routes (Admin SDK) touch these.
    match /aiBudget/{period} {
      allow read, write: if false;
    }

    // Moderation notes: only the server (Admin SDK) touches these.
    match /siteModeration/{siteId} {
      allow read, write: if false;
    }

    // One live page at a time, by its link. Listing would hand out every
    // published link at once, so it is refused.
    match /publicSites/{slug} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /slugs/{slug} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isOwner(resource);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
