# ---------------------------------------------------------------------------
# Webbi environment variables
# Copy to .env.local for local development. On Netlify, set these under
# Site configuration → Environment variables. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Firebase web app (public; safe in the browser, governed by security rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
# Auth domain: where Firebase's Google sign-in handler runs, and the domain Google's
# account chooser names ("to continue to …"). webbi-85f26.firebaseapp.com works
# anywhere. Production can use webbi.online, because next.config.ts proxies /__/auth/*
# to Firebase, but only after https://webbi.online/__/auth/handler is an authorized
# redirect URI on the Google OAuth web client. See README "Google sign-in domain".
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=webbi-85f26.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=webbi-85f26
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=webbi-85f26.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Public site URL (no trailing slash). Used for share links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase Admin SDK (server only).
# Base64 of the service-account JSON: `base64 -i service-account.json | tr -d '\n'`.
# Alternative for local dev: leave empty and run `gcloud auth application-default login`.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- AI (server only). OpenAI is the production provider.
# OPENAI_API_KEY is the variable the code reads; it is the one set on Netlify.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# openai | anthropic | mock. Leave unset to pick from whichever key is configured
# (OPENAI_API_KEY first). The mock provider only copies your words into the
# site structure so the flow can be tested without a key. Refused in production.
AI_PROVIDER=
# Optional alternative provider (only used when AI_PROVIDER=anthropic, or when
# OPENAI_API_KEY is unset and ANTHROPIC_API_KEY is set).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Webbi-wide AI budget (server only): requests across ALL accounts per Malaysia
# day / month, counted atomically with each account's own limits. Unset or not a
# whole number = the defaults (500 a day, 6000 a month). 0 switches the AI off.
AI_GLOBAL_DAILY_LIMIT=
AI_GLOBAL_MONTHLY_LIMIT=

# --- App Check (reCAPTCHA Enterprise). See README "App Check".
# Public site key from Firebase Console → App Check → the web app. Unset = the
# browser never loads reCAPTCHA and sends no App Check token.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Local development only (ignored in production builds): a debug token registered
# under App Check → Manage debug tokens, or "true" to have the SDK print one.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Server: off (default) | monitor (log requests without a valid token) | enforce
# (refuse them with 401). Checked on /api/sites, /api/sites/images and the AI routes.
APP_CHECK_MODE=off

# --- Owner admin panel (/admin). See README "Admin panel".
# Hostnames that may serve /admin and /api/admin, comma-separated. Unset = webbi.online.
# Production never serves it on *.netlify.app or localhost, whatever this says;
# outside production localhost and 127.0.0.1 are added. Customer domains never.
ADMIN_HOSTS=webbi.online
# Kill switch: "false" makes every admin page and API a 404. Unset = on.
ADMIN_PANEL_ENABLED=true

# --- Local Firebase Emulator Suite (development only; see README "Local dev")
# NEXT_PUBLIC_FIREBASE_EMULATOR=1
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Payments (server only; never give these a NEXT_PUBLIC_ prefix).
# PAYMENT_PROVIDER picks the adapter:
#   (unset) – Billplz once all three BILLPLZ_* keys below are set, otherwise off.
#   billplz – Billplz, Webbi's payment provider. Production API only.
#   none    – payments off even with keys set; Publish shows an honest
#             "not switched on yet" state.
#   stripe  – Stripe Checkout (reference adapter). Needs the STRIPE_* keys plus a
#             webhook at /api/payments/webhook for checkout.session.* events.
#   mock    – local development only (refused in production). Walks the publish
#             flow against the emulators without a real payment.
PAYMENT_PROVIDER=
# From the Billplz account. X Signature must be switched on there: callbacks
# and return links without a valid signature are rejected.
BILLPLZ_SECRET_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
# Production API. A sandbox URL is refused in production.
BILLPLZ_BASE_URL=https://www.billplz.com/api/
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
