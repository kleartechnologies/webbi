{
  "name": "webbi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-webbi \"vitest run --fileParallelism=false src/lib/site/__tests__/drafts.emulator.test.ts src/lib/ai/__tests__/guard.emulator.test.ts src/lib/images/__tests__/storage.emulator.test.ts src/lib/site/__tests__/publish.emulator.test.ts src/lib/admin/__tests__/admin.emulator.test.ts\"",
    "qa:auth": "node scripts/qa/auth-flow.mjs",
    "qa:landing": "node scripts/qa/landing.mjs",
    "qa:publish": "node scripts/qa/publish-flow.mjs",
    "qa:industries": "node scripts/qa/industries.mjs",
    "qa:profile-location": "node scripts/qa/profile-location.mjs",
    "qa:hero-shapes": "node scripts/qa/hero-shapes.mjs",
    "qa:templates": "node scripts/qa/templates.mjs",
    "qa:share": "node scripts/qa/share.mjs",
    "qa:headers": "node scripts/qa/security-headers.mjs",
    "qa:cleanup": "node scripts/qa/cleanup-anonymous.mjs",
    "qa:admin": "node scripts/qa/admin.mjs",
    "ops:moderate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ops/moderate.mjs",
    "ops:admin-role": "node scripts/ops/admin-role.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "openai": "^7.15.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
